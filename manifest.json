{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Buttercup Revival",
  "key": "",
  "version": "0.7.0",
  "description": "Better YouTube captions with local audio extraction and configurable transcription APIs",
  "permissions": ["storage", "scripting", "offscreen", "activeTab", "downloads", "nativeMessaging"],
  "host_permissions": ["https://www.youtube.com/*", "https://openrouter.ai/*", "https://api.deepinfra.com/*", "https://api.groq.com/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background/worker.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*"], "js": ["buttercup.js", "content.js"], "run_at": "document_idle" }],
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" },
  "commands": {
    "generate-subtitles": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Generate captions (reuse cached subtitles when available)"
    },
    "regenerate-subtitles": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Regenerate captions (fresh provider request; charges may apply)"
    }
  }
}
