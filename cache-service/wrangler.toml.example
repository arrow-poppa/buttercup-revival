name = "buttercup-community-cache"
main = "worker.js"
compatibility_date = "2026-10-01"

[vars]
ALLOWED_ORIGINS = "chrome-extension://REPLACE_WITH_YOUR_EXTENSION_ID"

[[d1_databases]]
binding = "DB"
database_name = "buttercup-subtitles"
database_id = "REPLACE_WITH_D1_ID"

[[ratelimits]]
name = "READ_LIMITER"
namespace_id = "1001"
simple = { limit = 120, period = 60 }

[[ratelimits]]
name = "WRITE_LIMITER"
namespace_id = "1002"
simple = { limit = 10, period = 60 }
